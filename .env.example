# 実値・秘密値は記入せず、Renderの環境変数またはローカルの.envへ設定する
APP_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173

# ローカルPostgreSQL。RenderではDATABASE_URLを設定する
PGHOST=.postgres/socket
PGPORT=55432
PGUSER=mvp_user
PGPASSWORD=
PGDATABASE=lesson4_mvp
DATABASE_URL=
DATABASE_SSL_MODE=disable

# メンター1名用。パスワードはハッシュのみ保存する
DEMO_USERNAME=
DEMO_DISPLAY_NAME=
DEMO_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# デモデータ以外を扱わない安全スイッチ
DEMO_DATA_ONLY=true
DEMO_DATA_AS_OF=2026-09-06

# gemini: 明示同意後だけ外部接続 / mock: 外部送信なし
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
